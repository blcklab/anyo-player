{
  "name": "@blcklab/anyo-player",
  "version": "0.5.0",
  "description": "Production-ready browser player for Anyo worlds with Sekai64 rendering, lifecycle, input, recovery, navigation, XR, and framework adapters.",
  "keywords": [
    "anyo",
    "sekai64",
    "3d",
    "webgpu",
    "webgl2",
    "webxr",
    "virtual-world",
    "player"
  ],
  "license": "MIT",
  "author": "Avelurs Tinio",
  "type": "module",
  "sideEffects": [
    "./dist/styles.css",
    "./dist/element-define.js"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs",
    "validation",
    "scripts/validation-server.mjs",
    "scripts/validate-evidence.mjs",
    "scripts/browser-matrix.mjs",
    "scripts/memory-profile.mjs",
    "scripts/safari-smoke.mjs",
    "scripts/verify-published-cdn.mjs",
    "scripts/lib/static-server.mjs"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./element/define": {
      "types": "./dist/element-define.d.ts",
      "import": "./dist/element-define.js"
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:examples": "tsc -p tsconfig.examples.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs",
    "check:exports": "node scripts/verify-exports.mjs",
    "check:boundaries": "node scripts/verify-boundaries.mjs",
    "check:pack": "node scripts/verify-package.mjs",
    "size": "node scripts/size.mjs",
    "check": "npm run typecheck && npm run typecheck:examples && npm test && npm run check:exports && npm run check:boundaries && npm run check:cdn && npm run check:hardening && npm run check:validation && npm run verify:track-f && npm run check:pack && npm run size",
    "prepublishOnly": "npm run check",
    "check:cdn": "node scripts/verify-cdn.mjs",
    "check:hardening": "node scripts/verify-adapter-hardening.mjs",
    "test:adapters": "npm run build && node --test tests/framework-adapter-controller.test.mjs tests/custom-element.test.mjs tests/element-define.test.mjs tests/vue-adapter.test.mjs tests/react-adapter.test.mjs tests/adapter-hardening.test.mjs",
    "validation:serve": "npm run build && node scripts/validation-server.mjs",
    "validation:check": "node scripts/validate-evidence.mjs",
    "validation:strict": "node scripts/validate-evidence.mjs --strict",
    "check:validation": "node scripts/verify-validation.mjs",
    "test:browser:matrix": "npm run build && node scripts/browser-matrix.mjs",
    "test:memory": "npm run build && node scripts/memory-profile.mjs",
    "test:safari": "npm run build && node scripts/safari-smoke.mjs",
    "validation:matrix": "npm run build && node scripts/browser-matrix.mjs",
    "validation:memory": "npm run build && node scripts/memory-profile.mjs",
    "validation:cdn:published": "node scripts/verify-published-cdn.mjs",
    "validation:frameworks": "npm run build && PLAYWRIGHT_BROWSERS=chromium node scripts/browser-matrix.mjs",
    "benchmark:track-d": "npm run build && node scripts/benchmark-track-d.mjs",
    "verify:track-f": "node scripts/verify-track-f.mjs",
    "test:track-f": "npm run build && node --test tests/track-f-production.test.mjs && npm run verify:track-f",
    "test:track-f:browser": "npm run build && node scripts/track-f-browser-smoke.mjs",
    "validation:track-f": "node scripts/validate-evidence.mjs",
    "validation:track-f:strict": "node scripts/validate-evidence.mjs --strict",
    "test:production": "npm run build && node --test tests/track-f-production.test.mjs && npm run verify:track-f",
    "validation:production": "node scripts/validate-evidence.mjs",
    "validation:production:strict": "node scripts/validate-evidence.mjs --strict"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@blcklab/anyo": ">=0.10.0-rc.1 <1.0.0",
    "@blcklab/sekai64": ">=0.7.0 <0.8.0 || >=0.8.0-0 <0.9.0",
    "react": ">=18.2.0 <20.0.0",
    "react-dom": ">=18.2.0 <20.0.0",
    "vue": ">=3.4.0 <4.0.0"
  },
  "devDependencies": {
    "@blcklab/anyo": "0.10.0-rc.1",
    "@blcklab/sekai64": "0.8.0-rc.33",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.3",
    "vue": "^3.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blcklab/anyo-player.git"
  },
  "bugs": {
    "url": "https://github.com/blcklab/anyo-player/issues"
  },
  "homepage": "https://github.com/blcklab/anyo-player#readme",
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
